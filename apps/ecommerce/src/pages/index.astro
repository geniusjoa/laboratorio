      color: var(--primary-amber);
      display: inline-block;
      margin-bottom: 0.4rem;
      font-weight: 700;
    }
    .about-card-title {
      font-size: 1.35rem;
      font-weight: 900;
      color: #FFFFFF;
      line-height: 1.25;
      margin-bottom: 0.5rem;
    }
    .about-card-subtitle {
      color: #9CA3AF;
      font-size: 0.85rem;
      line-height: 1.5;
      margin-bottom: 1.3rem;
    }
    .about-highlights-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
    .about-highlight-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 159, 28, 0.18);
      border-radius: 14px;
      padding: 0.85rem 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      transition: all 0.25s ease;
    }
    .about-highlight-item:hover {
      border-color: var(--primary-amber);
      background: rgba(255, 159, 28, 0.08);
      transform: translateX(4px);
    }
    .about-highlight-icon {
      font-size: 1.7rem;
      line-height: 1;
      filter: drop-shadow(0 2px 6px rgba(255, 159, 28, 0.3));
      flex-shrink: 0;
    }
    .about-highlight-title {
      color: #FFFFFF;
      font-size: 0.92rem;
      font-weight: 800;
      margin-bottom: 0.15rem;
    }
    .about-highlight-desc {
      color: #9CA3AF;
      font-size: 0.78rem;
      line-height: 1.35;
    }
    .about-tech-tag {
      margin-top: 1.2rem;
      padding-top: 0.9rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      color: #D1D5DB;
      font-size: 0.76rem;
      text-align: center;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    /* Footer Institucional */
    footer {
      background: #07080A;
      border-top: 1px solid #191B24;
      padding: 4.5rem 1.5rem 2.5rem;
      color: #9CA3AF;
    }
    .footer-content-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 3rem;
      margin-bottom: 3.5rem;
    }

    .footer-brand-box p {
      font-size: 0.88rem;
      line-height: 1.65;
      margin: 1.25rem 0 1.5rem;
      max-width: 320px;
    }
    .footer-social-row {
      display: flex;
      gap: 0.75rem;
    }
    .social-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #14161E;
      border: 1px solid #232733;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .social-btn:hover {
      background: var(--primary-amber);
      color: #0B0C10;
      border-color: var(--primary-amber);
    }

    .footer-col-title {
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: #FFFFFF;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
    }
    .footer-links-list {
      list-style: none;
    }
    .footer-links-list li {
      margin-bottom: 0.7rem;
    }
    .footer-links-list a {
      color: #9CA3AF;
      text-decoration: none;
      font-size: 0.88rem;
      transition: color 0.2s;
    }
    .footer-links-list a:hover {
      color: var(--primary-amber);
    }

    .app-badges-col p {
      font-size: 0.82rem;
      margin-bottom: 0.6rem;
      color: #9CA3AF;
    }
    .app-store-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      background: #14161E;
      border: 1px solid #282D3E;
      border-radius: 12px;
      padding: 0.6rem 1.15rem;
      text-decoration: none;
      color: #FFFFFF;
      margin-bottom: 0.75rem;
      transition: all 0.2s;
      width: 100%;
      max-width: 200px;
    }
    .app-store-badge:hover {
      border-color: var(--primary-amber);
      transform: translateY(-2px);
    }
    .badge-icon {
      font-size: 1.6rem;
    }
    .badge-texts {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .badge-sub {
      font-size: 0.6rem;
      text-transform: uppercase;
      color: #9CA3AF;
      letter-spacing: 0.06em;
    }
    .badge-main {
      font-size: 0.92rem;
      font-weight: 800;
      color: #FFFFFF;
    }

    .footer-bottom-bar {
      max-width: 1240px;
      margin: 0 auto;
      padding-top: 2rem;
      border-top: 1px solid #14161E;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: #6B7280;
      flex-wrap: wrap;
      gap: 1rem;
    }

    /* Drawer de Carrito de Compras */
    .cart-drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 100;
      display: none;
      justify-content: flex-end;
    }
    .cart-drawer-backdrop.open {
      display: flex;
    }
    .cart-drawer {
      background: #12141C;
      width: 100%;
      max-width: 440px;
      height: 100%;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      border-left: 1px solid var(--border-dark);
      animation: slideInRight 0.3s ease-out;
    }
    @keyframes slideInRight {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    .cart-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-dark);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .cart-header h3 {
      font-family: var(--font-display);
      font-size: 1.8rem;
      letter-spacing: 0.05em;
      color: #FFFFFF;
      text-transform: uppercase;
    }
    .cart-close-btn {
      background: transparent;
      border: none;
      color: #FFFFFF;
      font-size: 1.8rem;
      cursor: pointer;
      line-height: 1;
    }
    .cart-items-wrap {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .cart-empty-text {
      text-align: center;
      color: #6B7280;
      margin-top: 3rem;
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #181B26;
      border: 1px solid #232838;
      border-radius: 12px;
      padding: 0.75rem;
    }
    .cart-item-row img {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      object-fit: cover;
    }
    .cart-item-info {
      flex: 1;
    }
    .cart-item-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: #FFFFFF;
    }
    .cart-item-price {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--primary-amber);
    }
    .cart-item-remove {
      background: transparent;
      border: none;
      color: #EF4444;
      cursor: pointer;
      font-size: 1.1rem;
    }
    .cart-footer {
      padding: 1.5rem;
      border-top: 1px solid var(--border-dark);
      background: #0E1017;
    }
    .cart-subtotal-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1.25rem;
      font-size: 1.15rem;
      font-weight: 800;
    }

    /* Modal de Especificaciones */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      z-index: 110;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-overlay.open {
      display: flex;
    }
    .modal-box {
      background: #14161E;
      border: 1px solid var(--border-amber);
      border-radius: 24px;
      max-width: 650px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
      position: relative;
      animation: modalFade 0.25s ease-out;
    }
    @keyframes modalFade {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    .modal-close-icon {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(11, 12, 16, 0.8);
      border: 1px solid var(--border-dark);
      color: #FFFFFF;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
    }
    .modal-photo {
      width: 100%;
      height: 270px;
      object-fit: cover;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
    }
    .modal-inner-padding {
      padding: 2rem;
    }

    /* Modal de Video */
    .video-modal-box {
      background: #000000;
      border: 1px solid var(--border-dark);
      border-radius: 20px;
      max-width: 750px;
      width: 100%;
      padding: 1.5rem;
      position: relative;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .hero-section {
        grid-template-columns: 1fr;
        padding-top: 2rem;
        gap: 2.5rem;
      }
      .hero-right {
        order: -1;
      }
      .category-strip-card {
        grid-template-columns: repeat(3, 1fr);
      }
      .bestsellers-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .promo-banner-card {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .promo-right {
        text-align: center;
      }
      .footer-content-wrap {
        grid-template-columns: 1fr 1fr;
      }
      .pwa-layer-card {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .nav-menu { display: none; }
      .hero-main-title .word-amber { font-size: 4.2rem; }
      .category-strip-card { grid-template-columns: repeat(2, 1fr); }
      .bestsellers-grid { grid-template-columns: 1fr; }
      .footer-content-wrap { grid-template-columns: 1fr; }
    }

    /* ========================================================
       💀 AMBIENTACIÓN TOTAL DE TERROR GÓTICO / NOCHE DE BRUJAS 🩸
       ======================================================== */
    .horror-screen-vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 999;
      box-shadow: inset 0 0 130px rgba(0, 0, 0, 0.95), inset 0 0 50px rgba(185, 28, 28, 0.28);
    }

    .blood-drips-wrap {
      width: 100%;
      line-height: 0;
      position: relative;
      z-index: 79;
      margin-top: -1px;
      filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.9));
    }

    .creepy-eyes {
      position: absolute;
      display: flex;
      gap: 12px;
      z-index: 12;
      pointer-events: none;
      animation: eyesBlink 4.5s infinite;
    }
    .creepy-eyes .eye {
      width: 13px;
      height: 7px;
      background: radial-gradient(circle, #EF4444 35%, #991B1B 80%);
      border-radius: 50%;
      box-shadow: 0 0 12px #EF4444, 0 0 24px #DC2626;
    }
    .creepy-eyes.yellow .eye {
      background: radial-gradient(circle, #FBBF24 35%, #D97706 80%);
      box-shadow: 0 0 12px #FBBF24, 0 0 24px #B45309;
    }
    @keyframes eyesBlink {
      0%, 88%, 94%, 100% { transform: scaleY(1); opacity: 0.95; }
      90%, 92% { transform: scaleY(0.08); opacity: 0.1; }
    }

    .hanging-spider {
      position: absolute;
      top: 0;
      left: 18%;
      z-index: 15;
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: spiderSwing 4.5s ease-in-out infinite alternate;
      transform-origin: top center;
      pointer-events: none;
    }
    .spider-thread {
      width: 1px;
      height: 60px;
      background: rgba(255, 255, 255, 0.3);
    }
    .spider-body {
      font-size: 1.5rem;
      line-height: 1;
      margin-top: -3px;
      filter: drop-shadow(0 2px 6px rgba(0,0,0,0.9));
    }
    @keyframes spiderSwing {
      0% { transform: rotate(-15deg); }
      100% { transform: rotate(15deg); }
    }

    .floating-horror-skull {
      position: absolute;
      z-index: 10;
      pointer-events: none;
      user-select: none;
    }
    .skull-1 {
      top: -15px;
      left: -20px;
      font-size: 2.2rem;
      filter: drop-shadow(0 0 15px rgba(220, 38, 38, 0.8));
      animation: skullHover 5s ease-in-out infinite alternate;
    }
    .skull-2 {
      bottom: -10px;
      left: 20px;
      font-size: 2rem;
      filter: drop-shadow(0 0 15px rgba(239, 68, 68, 0.7));
      animation: skullHover 4s ease-in-out infinite alternate-reverse;
    }
    .tomb-1 {
      bottom: 10px;
      right: -25px;
      font-size: 2.2rem;
      filter: drop-shadow(0 0 12px rgba(124, 58, 237, 0.8));
      animation: batFly2 6s ease-in-out infinite alternate;
    }
    .candle-1 {
      top: 25px;
      right: -20px;
      font-size: 1.8rem;
      filter: drop-shadow(0 0 15px rgba(255, 117, 24, 0.9));
      animation: ghostHover 4s ease-in-out infinite alternate;
    }

    @keyframes skullHover {
      0% { transform: translate(0, 0) rotate(0deg); opacity: 0.85; }
      50% { transform: translate(-10px, -18px) rotate(-12deg); opacity: 1; }
      100% { transform: translate(8px, -28px) rotate(10deg); opacity: 0.75; }
    }

    .word-horror-sub {
      display: block;
      font-family: var(--font-horror);
      font-size: 3.2rem;
      letter-spacing: 0.08em;
      color: #EF4444;
      text-shadow: 0 0 15px #DC2626, 0 0 30px #7F1D1D, 0 0 45px #000000;
      animation: horrorTorchFlicker 3s infinite alternate;
      margin-bottom: 0.3rem;
      line-height: 1;
    }
    .word-blood-drip {
      display: block;
      font-family: var(--font-horror);
      font-size: 4.8rem;
      color: #F87171;
      letter-spacing: 0.08em;
      text-shadow: 0 0 12px #B91C1C, 0 0 25px #7F1D1D, 2px 2px 0 #450A0A;
      line-height: 0.95;
      margin-bottom: 0.2rem;
    }
    .horror-glow-text {
      color: #FF7518 !important;
      font-family: var(--font-display);
      font-size: 6.8rem !important;
      letter-spacing: 0.04em;
      text-shadow: 0 0 25px rgba(239, 68, 68, 0.75), 0 0 50px rgba(127, 29, 29, 0.95), 0 4px 10px #000000 !important;
      animation: horrorRumble 4s ease-in-out infinite alternate;
    }
    @keyframes horrorTorchFlicker {
      0%, 100% { opacity: 1; filter: brightness(1.1); }
      30% { opacity: 0.82; filter: brightness(0.9); }
      60% { opacity: 0.95; filter: brightness(1.2); }
      85% { opacity: 0.78; filter: brightness(0.85); }
    }
    @keyframes horrorRumble {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-3px) scale(1.01); }
    }

    .halloween-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: linear-gradient(135deg, rgba(185, 28, 28, 0.5) 0%, rgba(88, 28, 135, 0.5) 100%);
      border: 1px solid #DC2626;
      color: #FEE2E2;
      padding: 0.4rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: 0 0 25px rgba(220, 38, 38, 0.5), inset 0 0 10px rgba(127, 29, 29, 0.4);
      animation: spookyAura 3s ease-in-out infinite alternate;
      margin-bottom: 1rem;
    }
    @keyframes spookyAura {
      0% { box-shadow: 0 0 15px rgba(220, 38, 38, 0.45); border-color: #DC2626; }
      50% { box-shadow: 0 0 35px rgba(147, 51, 234, 0.65); border-color: #9333EA; }
      100% { box-shadow: 0 0 25px rgba(239, 68, 68, 0.6); border-color: #EF4444; }
    }

    .spooky-bat-float {
      position: absolute;
      font-size: 2rem;
      pointer-events: none;
      user-select: none;
      z-index: 10;
      filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.95));
      opacity: 0.9;
    }
    .bat-hero-1 {
      top: -20px;
      right: 20px;
      animation: batFly1 5s ease-in-out infinite alternate;
    }
    .bat-hero-2 {
      bottom: 40px;
      left: -25px;
      animation: batFly2 7s ease-in-out infinite alternate;
      font-size: 2.4rem;
    }
    .ghost-hero {
      top: 30px;
      left: -20px;
      animation: ghostHover 4s ease-in-out infinite alternate;
      font-size: 2.2rem;
    }
    .pumpkin-hero {
      bottom: -15px;
      right: -10px;
      animation: pumpkinWiggle 3.5s ease-in-out infinite;
      font-size: 2.5rem;
    }

    @keyframes batFly1 {
      0% { transform: translateY(0) rotate(0deg) scale(1); }
      50% { transform: translateY(-18px) translateX(15px) rotate(15deg) scale(1.1); }
      100% { transform: translateY(-30px) translateX(-10px) rotate(-10deg) scale(0.95); }
    }
    @keyframes batFly2 {
      0% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(20px) translateX(-20px) rotate(-18deg) scale(1.15); }
      100% { transform: translateY(-10px) translateX(15px) rotate(8deg); }
    }
    @keyframes ghostHover {
      0% { transform: translateY(0) scale(1); opacity: 0.75; }
      50% { transform: translateY(-15px) translateX(-10px) scale(1.08); opacity: 1; }
      100% { transform: translateY(-5px) translateX(8px) scale(1); opacity: 0.7; }
    }
    @keyframes pumpkinWiggle {
      0%, 100% { transform: rotate(0deg) scale(1); }
      25% { transform: rotate(-8deg) scale(1.05); }
      75% { transform: rotate(8deg) scale(1.05); }
    }

    /* Telarañas en esquinas */
    .spooky-spiderweb-tr {
      position: absolute;
      top: 0;
      right: 0;
      font-size: 3rem;
      opacity: 0.45;
      pointer-events: none;
      line-height: 1;
      user-select: none;
      filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
    }
    .spooky-spiderweb-tl {
      position: absolute;
      top: 0;
      left: 0;
      font-size: 3rem;
      opacity: 0.45;
      pointer-events: none;
      line-height: 1;
      user-select: none;
      filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
    }

    /* Glow de Terror en botones y badges */
    .halloween-pill-glow {
      border-color: rgba(255, 87, 34, 0.7) !important;
      background: rgba(220, 38, 38, 0.15) !important;
      box-shadow: 0 0 25px rgba(255, 87, 34, 0.45);
    }
    .btn-halloween-order {
      background: linear-gradient(135deg, #DC2626 0%, #991B1B 50%, #450A0A 100%) !important;
      color: #FFFFFF !important;
      box-shadow: 0 6px 25px rgba(220, 38, 38, 0.6) !important;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.7);
      border: 1px solid #EF4444 !important;
    }
    .btn-halloween-order:hover {
      box-shadow: 0 8px 30px rgba(239, 68, 68, 0.85) !important;
      transform: translateY(-3px) scale(1.03);
    }

    /* Estilo de Fuego & Brasas Infernales inspirado en imagen/5750a1fa7a4ced11fceee22fa76fa813.jpg */
    .btn-halloween-fire {
      background: linear-gradient(135deg, #FF5722 0%, #E65100 45%, #B71C1C 100%) !important;
      color: #FFFFFF !important;
      font-weight: 900 !important;
      letter-spacing: 0.08em !important;
      box-shadow: 0 0 25px rgba(255, 87, 34, 0.65), 0 6px 20px rgba(183, 28, 28, 0.5) !important;
      border: 1px solid #FF8A65 !important;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8) !important;
      transition: all 0.25s ease !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.65rem !important;
      animation: buttonFlamePulse 2.8s ease-in-out infinite alternate;
    }
    .btn-halloween-fire:hover {
      background: linear-gradient(135deg, #FF7043 0%, #F4511E 45%, #C62828 100%) !important;
      transform: translateY(-3px) scale(1.04) !important;
      box-shadow: 0 0 35px rgba(255, 87, 34, 0.95), 0 8px 30px rgba(220, 38, 38, 0.75) !important;
    }
    @keyframes buttonFlamePulse {
      0% { box-shadow: 0 0 20px rgba(255, 87, 34, 0.55), 0 4px 15px rgba(183, 28, 28, 0.4); }
      100% { box-shadow: 0 0 35px rgba(255, 87, 34, 0.85), 0 8px 25px rgba(220, 38, 38, 0.65); }
    }

    /* Aura de Fuego y Brasas en Burger Chief */
    .hero-hellfire-aura {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 490px;
      height: 490px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 87, 34, 0.48) 0%, rgba(220, 38, 38, 0.38) 45%, rgba(127, 29, 29, 0.15) 70%, transparent 85%);
      filter: blur(42px);
      z-index: 0;
      pointer-events: none;
      animation: flamePulse 3.5s ease-in-out infinite alternate;
    }
    @keyframes flamePulse {
      0% { transform: translate(-50%, -50%) scale(0.92); opacity: 0.75; filter: blur(35px); }
      50% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; filter: blur(48px); }
      100% { transform: translate(-50%, -50%) scale(1.02); opacity: 0.85; filter: blur(40px); }
    }

