<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #FBF9F5;
      --surface: #FFFFFF;
      --surface-subtle: #F6F2EC;
      --border: #EFE7DE;
      --border-hover: #DBC8B5;
      
      --text: #1C1917;
      --text-muted: #78716C;
      --text-light: #A8A29E;
      
      --primary: #D97706;
      --primary-dark: #B45309;
      --primary-light: #FEF3C7;
      
      --accent-crimson: #DC2626;
      --accent-crimson-bg: #FEE2E2;
      
      --accent-emerald: #059669;
      --accent-emerald-bg: #D1FAE5;
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      
      --shadow-sm: 0 2px 8px rgba(120, 53, 15, 0.04);
      --shadow-md: 0 10px 25px rgba(120, 53, 15, 0.07);
      --shadow-lg: 0 20px 45px rgba(120, 53, 15, 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Top Announcement Bar */
    .announcement {
      background: #1C1917;
      color: #FBBF24;
      font-size: 0.8rem;
      font-weight: 700;
      text-align: center;
      padding: 0.55rem 1rem;
      letter-spacing: 0.05em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
    }
    .announcement a {
      color: #FFFFFF;
      text-decoration: underline;
      margin-left: 0.5rem;
    }

    /* Header & Navigation */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(251, 249, 245, 0.92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      transition: all 0.3s;
    }
    .header-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo-container {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text);
    }
    .logo-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #F59E0B, #DC2626);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }
    .logo-text h1 {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: #1C1917;
    }
    .logo-text span {
      font-size: 0.7rem;
      text-transform: uppercase;
      font-weight: 800;
      color: var(--primary);
      letter-spacing: 0.12em;
    }
    
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      list-style: none;
    }
    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.92rem;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: var(--primary);
      color: white;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
    }
    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(217, 119, 6, 0.35);
    }
    .btn-outline {
      background: var(--surface);
      border-color: var(--border);
      color: var(--text);
    }
    .btn-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: var(--surface-subtle);
    }
    .btn-dark {
      background: #1C1917;
      color: white;
    }
    .btn-dark:hover {
      background: #292524;
      transform: translateY(-2px);
    }

    /* Hero Section */
    .hero {
      position: relative;
      padding: 4.5rem 1.5rem 4rem;
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3.5rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary-light);
      border: 1px solid #FDE68A;
      color: var(--primary-dark);
      padding: 0.45rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      margin-bottom: 1.5rem;
    }
    .hero-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: #1C1917;
      margin-bottom: 1.25rem;
    }
    .hero-title .highlight {
      background: linear-gradient(135deg, #D97706, #DC2626);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 2.25rem;
      max-width: 580px;
    }
    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 3rem;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }
    .stat-item h4 {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--text);
    }
    .stat-item p {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    /* Hero Showcase Image */
    .hero-showcase {
      position: relative;
    }
    .hero-img-wrap {
      position: relative;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(120, 53, 15, 0.15);
      border: 6px solid #FFFFFF;
      aspect-ratio: 4 / 3.8;
      background: #EAE5DC;
    }
    .hero-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }
    .hero-img-wrap:hover img {
      transform: scale(1.04);
    }
    .floating-card {
      position: absolute;
      bottom: -15px;
      left: -20px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid var(--border);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: 0.85rem;
      max-width: 260px;
    }
    .floating-badge {
      width: 44px;
      height: 44px;
      background: #FEF3C7;
      color: #D97706;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
    }

    /* Feature Pillars */
    .pillars-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 3rem 1.5rem;
    }
    .pillars-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
    }
    .pillar-card {
      display: flex;
      gap: 1.15rem;
      align-items: flex-start;
    }
    .pillar-icon {
      width: 48px;
      height: 48px;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }
    .pillar-card h3 {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 0.25rem;
    }
    .pillar-card p {
      font-size: 0.86rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Catalog Section */
    .catalog-section {
      max-width: 1240px;
      margin: 0 auto;
      padding: 5rem 1.5rem;
    }
    .section-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 3rem;
    }
    .section-tag {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 0.5rem;
      display: block;
    }
    .section-title {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.85rem;
      color: #1C1917;
    }
    .section-desc {
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    /* Filter Pills */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.65rem;
      margin-bottom: 3rem;
    }
    .filter-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 0.6rem 1.25rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover {
      color: var(--text);
      border-color: var(--border-hover);
    }
    .filter-btn.active {
      background: #1C1917;
      color: #FFFFFF;
      border-color: #1C1917;
      box-shadow: 0 4px 12px rgba(28, 25, 23, 0.2);
    }

    /* Product Grid */
    .burger-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }
    .burger-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-sm);
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: var(--border-hover);
    }
    
    .card-thumb-wrap {
      position: relative;
      width: 100%;
      height: 230px;
      overflow: hidden;
      background: #F3EDE4;
    }
    .card-thumb-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .burger-card:hover .card-thumb-wrap img {
      transform: scale(1.08);
    }

    /* Specialty Badges */
    .badge-specialty {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      box-shadow: 0 4px 10px rgba(0,0,0,0.12);
      backdrop-filter: blur(8px);
    }
    .specialty-legendario {
      background: #FEF3C7;
      color: #92400E;
      border: 1px solid #F59E0B;
    }
    .specialty-elite {
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #F87171;
    }
    .specialty-superior {
      background: #FFEDD5;
      color: #9A3412;
      border: 1px solid #FB923C;
    }
    .specialty-clasico {
      background: #E0E7FF;
      color: #3730A3;
      border: 1px solid #818CF8;
    }
    .specialty-gourmet {
      background: #F3E8FF;
      color: #6B21A8;
      border: 1px solid #C084FC;
    }
    .specialty-dorado {
      background: #FEF9C3;
      color: #854D0E;
