    }
    .ticket-notch-left, .ticket-notch-right {
      position: absolute;
      top: 50%;
      width: 32px;
      height: 32px;
      background: #050308;
      border-radius: 50%;
      transform: translateY(-50%);
      z-index: 5;
    }
