          <div>
            <span style="font-size: 0.68rem; color: #9CA3AF; text-transform: uppercase; font-weight: 700;">Calorías</span>
            <div id="specsModalCalories" style="font-size: 0.92rem; font-weight: 800; color: #FFFFFF; margin-top: 0.2rem;"></div>
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <h4 style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary-amber); margin-bottom: 0.75rem;">
            Ingredientes Seleccionados:
          </h4>
          <ul id="specsModalIngredients" style="list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
          </ul>
        </div>

        <div style="display: flex; gap: 1rem; align-items: center; justify-content: flex-end;">
          <button id="addFromModalBtn" class="btn-pill-amber" style="padding: 0.75rem 1.75rem;">
            <span>+ Agregar al Pedido</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Video Modal -->
  <div id="videoModal" class="modal-overlay">
    <div class="video-modal-box">
      <button id="closeVideoModal" class="modal-close-icon">&times;</button>
      <h3 style="font-family: var(--font-display); font-size: 1.8rem; letter-spacing: 0.05em; color: var(--primary-amber); margin-bottom: 1rem; text-transform: uppercase;">
        TastyBites Craft & Gourmet Experience
      </h3>
      <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; background: #111;">
        <iframe 
          style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border: 0;"
          src="https://www.youtube-nocookie.com/embed/g6t83dU4cgk?autoplay=0" 
          title="TastyBites Burger Craft Video" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </div>

  <!-- Client-side Scripts -->
  <script>
    // 1. Interactive Shopping Cart
    interface CartItem {
      id: string;
      name: string;
      price: number;
      image: string;
      qty: number;
    }

    const cart: CartItem[] = [];
    const cartCountBadge = document.getElementById('cartCountBadge');
    const orderOnlineBtn = document.getElementById('orderOnlineBtn');
    const cartDrawer = document.getElementById('cartDrawerBackdrop');
    const closeCartBtn = document.getElementById('closeCartBtn');
    const cartItemsContainer = document.getElementById('cartItemsContainer');
    const cartSubtotal = document.getElementById('cartSubtotal');

    function updateCartUI() {
      const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
      const totalPrice = cart.reduce((acc, item) => acc + (item.price * item.qty), 0);

      if (cartCountBadge) {
        cartCountBadge.textContent = totalCount.toString();
      }

      if (cartSubtotal) {
        cartSubtotal.textContent = `$${totalPrice.toFixed(2)}`;
      }

      if (cartItemsContainer) {
        if (cart.length === 0) {
          cartItemsContainer.innerHTML = `
            <div class="cart-empty-text">Tu bolsa de TastyBites está vacía.<br/>Agrega hamburguesas o bestsellers pulsando <strong>+</strong>.</div>
          `;
        } else {
          cartItemsContainer.innerHTML = cart.map((item, idx) => `
            <div class="cart-item-row">
              <img src="${item.image}" alt="${item.name}" />
              <div class="cart-item-info">
                <div class="cart-item-title">${item.name}</div>
                <div class="cart-item-price">$${item.price.toFixed(2)} x ${item.qty}</div>
              </div>
              <button class="cart-item-remove" data-index="${idx}" title="Eliminar">&times;</button>
            </div>
          `).join('');

          // Bind remove buttons
          cartItemsContainer.querySelectorAll('.cart-item-remove').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const target = e.currentTarget as HTMLElement;
              const index = parseInt(target.getAttribute('data-index') || '0', 10);
              cart.splice(index, 1);
              updateCartUI();
            });
          });
        }
      }
    }

    // Add to cart buttons
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '0';
        const name = btn.getAttribute('data-name') || 'Item';
        const price = parseFloat(btn.getAttribute('data-price') || '0');
        const image = btn.getAttribute('data-image') || '';

        const existing = cart.find(i => i.name === name);
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({ id, name, price, image, qty: 1 });
        }

        updateCartUI();
        cartDrawer?.classList.add('open');
      });
    });

    orderOnlineBtn?.addEventListener('click', () => {
      cartDrawer?.classList.add('open');
    });

    closeCartBtn?.addEventListener('click', () => {
      cartDrawer?.classList.remove('open');
    });

    cartDrawer?.addEventListener('click', (e) => {
      if (e.target === cartDrawer) {
        cartDrawer.classList.remove('open');
      }
    });

    // 2. Category Strip Interactive Filter
    const catButtons = document.querySelectorAll('.cat-item-btn');
    const catalogCards = document.querySelectorAll('.menu-card');

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const selectedCat = btn.getAttribute('data-category');

        catalogCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === cardCat || selectedCat === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        const target = document.getElementById('full-menu');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // 3. Secondary Filter Pills for Full Catalog
    const filterPills = document.querySelectorAll('.filter-btn');
    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filterVal = pill.getAttribute('data-filter');

        catalogCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (filterVal === 'all' || cardCat === filterVal) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 4. Detailed Specs Modal
    const specsModal = document.getElementById('specsModal');
    const closeSpecsModal = document.getElementById('closeSpecsModal');
    const openSpecBtns = document.querySelectorAll('.open-spec-modal');

    const specsModalImg = document.getElementById('specsModalImg') as HTMLImageElement;
    const specsModalCat = document.getElementById('specsModalCat');
    const specsModalTitle = document.getElementById('specsModalTitle');
    const specsModalPrice = document.getElementById('specsModalPrice');
    const specsModalDesc = document.getElementById('specsModalDesc');
    const specsModalMeat = document.getElementById('specsModalMeat');
    const specsModalPrep = document.getElementById('specsModalPrep');
    const specsModalCalories = document.getElementById('specsModalCalories');
    const specsModalIngredients = document.getElementById('specsModalIngredients');
    const addFromModalBtn = document.getElementById('addFromModalBtn');

    let currentModalItem: any = null;

    openSpecBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name');
        const price = btn.getAttribute('data-price');
        const cat = btn.getAttribute('data-category');
        const image = btn.getAttribute('data-image');
        const desc = btn.getAttribute('data-desc');
        const meat = btn.getAttribute('data-meat');
        const prep = btn.getAttribute('data-prep');
        const calories = btn.getAttribute('data-calories');
        const ingredientsRaw = btn.getAttribute('data-ingredients');

        currentModalItem = { name, price: parseFloat(price || '0'), image };

        if (specsModalImg && image) specsModalImg.src = image;
        if (specsModalCat && cat) specsModalCat.textContent = cat;
        if (specsModalTitle && name) specsModalTitle.textContent = name;
        if (specsModalPrice && price) specsModalPrice.textContent = `$${price}`;
        if (specsModalDesc && desc) specsModalDesc.textContent = desc;
        if (specsModalMeat && meat) specsModalMeat.textContent = meat;
        if (specsModalPrep && prep) specsModalPrep.textContent = prep;
        if (specsModalCalories && calories) specsModalCalories.textContent = calories;

        if (specsModalIngredients && ingredientsRaw) {
          try {
            const list = JSON.parse(ingredientsRaw);
            specsModalIngredients.innerHTML = list.map((item: string) => `
              <li style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #D1D5DB;">
                <span style="color: #FF9F1C; font-weight: bold;">✔</span>
                <span>${item}</span>
              </li>
            `).join('');
          } catch(e) {
            specsModalIngredients.innerHTML = '';
          }
        }

        specsModal?.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });

    addFromModalBtn?.addEventListener('click', () => {
      if (currentModalItem) {
        const existing = cart.find(i => i.name === currentModalItem.name);
        if (existing) {
          existing.qty += 1;
        } else {
          cart.push({ ...currentModalItem, id: Date.now().toString(), qty: 1 });
        }
        updateCartUI();
        specsModal?.classList.remove('open');
        document.body.style.overflow = '';
        cartDrawer?.classList.add('open');
      }
    });

    closeSpecsModal?.addEventListener('click', () => {
      specsModal?.classList.remove('open');
      document.body.style.overflow = '';
    });

    specsModal?.addEventListener('click', (e) => {
      if (e.target === specsModal) {
        specsModal.classList.remove('open');
        document.body.style.overflow = '';
      }
    });

    // 5. Video Modal
    const videoModal = document.getElementById('videoModal');
    const watchVideoBtn = document.getElementById('watchVideoBtn');
    const closeVideoModal = document.getElementById('closeVideoModal');

    watchVideoBtn?.addEventListener('click', () => {
      videoModal?.classList.add('open');
      document.body.style.overflow = 'hidden';
    });

    closeVideoModal?.addEventListener('click', () => {
      videoModal?.classList.remove('open');
      document.body.style.overflow = '';
    });

    videoModal?.addEventListener('click', (e) => {
      if (e.target === videoModal) {
        videoModal.classList.remove('open');
        document.body.style.overflow = '';
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        specsModal?.classList.remove('open');
        videoModal?.classList.remove('open');
        cartDrawer?.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  </script>
</body>
</html>
