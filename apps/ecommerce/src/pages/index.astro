    .embers-container {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1;
    }
    .ember-spark {
      position: absolute;
      bottom: -20px;
      width: 6px;
      height: 6px;
      background: radial-gradient(circle, #FFF7ED 20%, #FF5722 60%, #DC2626 100%);
      border-radius: 50%;
      box-shadow: 0 0 10px #FF5722, 0 0 20px #DC2626, 0 0 35px #FF9800;
      animation: floatEmberUp 7s infinite ease-out;
      opacity: 0;
    }
    .spark-1 { left: 12%; animation-duration: 6.2s; animation-delay: 0.3s; width: 6px; height: 6px; }
    .spark-2 { left: 28%; animation-duration: 8.5s; animation-delay: 1.8s; width: 8px; height: 8px; }
    .spark-3 { left: 45%; animation-duration: 5.8s; animation-delay: 1.0s; width: 5px; height: 5px; }
    .spark-4 { left: 62%; animation-duration: 7.8s; animation-delay: 2.7s; width: 7px; height: 7px; }
    .spark-5 { left: 78%; animation-duration: 6.5s; animation-delay: 0.6s; width: 6px; height: 6px; }
    .spark-6 { left: 89%; animation-duration: 9.2s; animation-delay: 2.2s; width: 9px; height: 9px; }
    .spark-7 { left: 35%; animation-duration: 7.0s; animation-delay: 3.8s; width: 6px; height: 6px; }
    .spark-8 { left: 95%; animation-duration: 6.0s; animation-delay: 1.5s; width: 8px; height: 8px; }

    @keyframes floatEmberUp {
      0% { transform: translateY(0) translateX(0) scale(0.6); opacity: 0; }
      15% { opacity: 0.95; }
      80% { opacity: 0.85; }
      100% { transform: translateY(-560px) translateX(45px) scale(1.4); opacity: 0; }
