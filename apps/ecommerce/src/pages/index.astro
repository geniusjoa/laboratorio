    </div>

    <div class="footer-bottom">
      <div>&copy; 2026 Hamburger Rapid Inc. Todos los derechos reservados. Arquitectura MasterClass NextCollege.</div>
      <div style="display: flex; gap: 1.5rem;">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Inicio</a>
        <a href="/app" style="color: var(--text-muted); text-decoration: none;">App Móvil</a>
        <a href="/admin" style="color: var(--text-muted); text-decoration: none;">Panel Admin</a>
      </div>
    </div>
  </footer>

  <!-- Client-side Interactive Logic -->
  <script>
    // 1. Filtering Logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        burgerCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. Interactive Details Modal
    const modal = document.getElementById('detailModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const openModalBtns = document.querySelectorAll('.open-modal-btn');

    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle');
    const modalCategory = document.getElementById('modalCategory');
    const modalSpecialtyBadge = document.getElementById('modalSpecialtyBadge');
    const modalDesc = document.getElementById('modalDesc');
    const modalMeat = document.getElementById('modalMeat');
    const modalPrep = document.getElementById('modalPrep');
    const modalCalories = document.getElementById('modalCalories');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalPrice = document.getElementById('modalPrice');

    openModalBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-name');
        const price = btn.getAttribute('data-price');
        const specialty = btn.getAttribute('data-specialty');
        const level = btn.getAttribute('data-level');
        const category = btn.getAttribute('data-category');
        const image = btn.getAttribute('data-image');
        const desc = btn.getAttribute('data-desc');
        const meat = btn.getAttribute('data-meat');
        const prep = btn.getAttribute('data-prep');
        const calories = btn.getAttribute('data-calories');
        const ingredientsRaw = btn.getAttribute('data-ingredients');

        if (modalImg) modalImg.src = image || '';
        if (modalTitle) modalTitle.textContent = name || '';
        if (modalCategory) modalCategory.textContent = category || '';
        if (modalSpecialtyBadge) {
          modalSpecialtyBadge.textContent = specialty || '';
          modalSpecialtyBadge.className = `badge-specialty specialty-${level}`;
        }
        if (modalDesc) modalDesc.textContent = desc || '';
        if (modalMeat) modalMeat.textContent = meat || '';
        if (modalPrep) modalPrep.textContent = prep || '';
        if (modalCalories) modalCalories.textContent = calories || '';
        if (modalPrice) modalPrice.textContent = `$${price}`;

        if (modalIngredients && ingredientsRaw) {
          try {
            const list = JSON.parse(ingredientsRaw);
            modalIngredients.innerHTML = list.map((item: string) => `
              <li style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: #57534E;">
                <span style="color: #059669; font-weight: bold;">✔</span>
                <span>${item}</span>
              </li>
            `).join('');
          } catch(e) {
            modalIngredients.innerHTML = '';
          }
        }

        modal?.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });

    closeModalBtn?.addEventListener('click', () => {
      modal?.classList.remove('open');
      document.body.style.overflow = '';
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) {
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  </script>
</body>
</html>
